{
  "name": "open-exercise-atlas",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "An open-source, multilingual exercise database with structured JSON data, muscle targeting, equipment information, and visual exercise guides.",
  "scripts": {
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "data:build": "node --experimental-strip-types scripts/build.ts",
    "data:check": "node --experimental-strip-types scripts/build.ts --check",
    "translation:report": "node --experimental-strip-types scripts/translations.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "npm run data:build && tsc --noEmit && vite build --config site/vite.config.ts && node --experimental-strip-types scripts/copy-media.ts",
    "dev": "vite --config site/vite.config.ts"
  },
  "dependencies": {"ajv": "^8.17.1", "ajv-formats": "^3.0.1", "react": "^19.2.0", "react-dom": "^19.2.0"},
  "devDependencies": {"@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.0.0", "typescript": "~5.9.3", "vite": "^7.0.0", "vitest": "^5.0.4"}
}
